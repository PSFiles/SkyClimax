# Pinned tool versions for SkyClimax.
# Source of truth for scripts/install-tools.ps1 and scripts/verify-tools.ps1.
# Bump a version only together with the checksum and docs/en-US/research/tooling.md.

GHIDRA_VERSION="12.2"
GHIDRA_BUILD="20261016"
GHIDRA_ZIP="ghidra_${GHIDRA_VERSION}_PUBLIC_${GHIDRA_BUILD}.zip"
GHIDRA_URL="https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_${GHIDRA_VERSION}_build/${GHIDRA_ZIP}"
GHIDRA_SHA256="2c2cd776db3c1f6a097ba418922378ac3649cadd5e844a6f5f088ae628a7be67"
GHIDRA_DIR="ghidra_${GHIDRA_VERSION}_PUBLIC"

# Ghidra 12.2 declares application.java.min=25, so JDK 21 is not usable.
JDK_MAJOR="25"
JDK_VERSION="25.0.5+8"
JDK_ZIP="temurin25-jdk-win-x64.zip"
JDK_URL="https://api.adoptium.net/v3/binary/latest/25/ga/windows/x64/jdk/hotspot/normal/eclipse"
JDK_SHA256="636bdc13dc649ddc7d5921c5c7d23cca6e44fd19d662b45cc9c02135a6c96c42"
JDK_DIR="jdk-${JDK_VERSION}"

# REA 6.9.0 requires node ^22.23.4 || ^24.22.1 || >=26.12.1.
NODE_VERSION="24.22.3"
NODE_ZIP="node-v${NODE_VERSION}-win-x64.zip"
NODE_URL="https://nodejs.org/dist/v${NODE_VERSION}/${NODE_ZIP}"
NODE_SHA256="e612af99f626ab415ea225af6bce5c971feb448cb5cae250bb1c3fa50c5f7d9f"
NODE_DIR="node-v${NODE_VERSION}-win-x64"

REA_VERSION="6.9.0"

PS3RECOMP_VERSION="0.19.0"
